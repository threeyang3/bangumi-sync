{
	"name": "bangumi-sync",
	"version": "6.12.1",
	"description": "Obsidian plugin to sync Bangumi collections",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run",
		"test:watch": "vitest",
		"docs:check": "node scripts/check-doc-links.mjs",
		"export:legacy-user-data": "node scripts/export-legacy-user-data.mjs",
		"version": "node version-bump.mjs && git add manifest.json package.json versions.json"
	},
	"keywords": [
		"obsidian",
		"bangumi",
		"sync"
	],
	"author": "threeyang",
	"license": "MIT",
	"engines": {
		"node": ">=22 <23"
	},
	"devDependencies": {
		"@types/node": "^22.19.19",
		"@typescript-eslint/parser": "^8.59.1",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.2.7",
		"obsidian": "1.12.3",
		"tslib": "2.4.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.59.1",
		"vite": "^8.3.0",
		"vitest": "^5.0.0"
	}
}
